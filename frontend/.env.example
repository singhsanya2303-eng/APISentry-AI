# Copy to a temporary build-specific env directory, not to frontend/.env.local.
# This is the only browser-visible backend configuration. It must point to the
# deployed HTTPS backend URL in production (for example https://api.example.test).
# Local development may keep the default backend address.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Vite exposes every VITE_* variable to the browser. Never define VITE_* names
# containing backend secrets such as JWT_SECRET_KEY, API_KEY, POSTGRES_PASSWORD,
# DATABASE_URL, or service credentials. Browser clients authenticate with a
# Bearer JWT obtained at login; they never require an X-API-Key.
