# Staging/production browser build template.
# Copy this file into a temporary APISENTRY_VITE_ENV_DIR and replace the
# placeholder host with the owner-approved HTTPS backend origin.
# This is the only browser-visible backend configuration. Never put backend
# secrets (JWT_SECRET_KEY, DATABASE_URL, POSTGRES_PASSWORD, API_KEY) in VITE_*.
VITE_API_BASE_URL=https://api.example.test
