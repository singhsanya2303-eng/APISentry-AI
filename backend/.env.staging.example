# Owner-reviewed staging template. Copy to an out-of-repo secret store or to
# backend/.env only on the target host. Never commit real secret values.
# Use the exact token `production` in production; aliases are rejected.
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=APISentry AI
VERSION=0.1.0
API_V1_STR=/api/v1

# Generate locally with a CSPRNG; never paste real values into this file.
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_43_CHAR_BASE64URL_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY=REPLACE_WITH_GENERATED_SERVICE_KEY_OR_LEAVE_EMPTY

# Replace with the exact HTTPS frontend origin(s). Wildcards are rejected.
CORS_ORIGINS=https://app.example.test
TRUSTED_PROXIES=

MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HEADERS_ENABLED=true

# Database: provide either DATABASE_URL or all five POSTGRES_* values.
# The value is injected by the owner/secret manager and never committed.
# DATABASE_URL=
POSTGRES_SERVER=REPLACE_WITH_DB_HOST
POSTGRES_PORT=5432
POSTGRES_USER=REPLACE_WITH_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=apisentry_db

# Production safety gates. Registration stays disabled.
AUTO_CREATE_SCHEMA=false
APISENTRY_ENABLE_PUBLIC_REGISTRATION=false
APISENTRY_ENABLE_DEMO_AUTH=false
APISENTRY_ENABLE_DEMO_CONTROL_PLANE=false
DEMO_USERNAME=demo_user
DEMO_PASSWORD=
MITIGATION_DEMO_DB_DIR=
