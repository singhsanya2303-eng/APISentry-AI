# APISENTRY environment template. Copy to backend/.env and replace placeholders.
# Never commit real secrets, tokens, credentials, or DSNs.

# Application. Use the exact value `production` for production; aliases such as
# `prod` are rejected rather than treated as development.
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=APISentry AI
VERSION=0.1.0
API_V1_STR=/api/v1

# Authentication. JWT_SECRET_KEY must be 43-char base64url or 64-hex chars and
# must not be predictable. Generate locally; do not paste the value into docs.
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_43_CHAR_BASE64URL_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY=REPLACE_WITH_GENERATED_SERVICE_KEY_OR_LEAVE_EMPTY

# origins are comma-separated absolute http(s) URLs; wildcard is rejected.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
TRUSTED_PROXIES=

# Safe defaults. Production should review every value.
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HEADERS_ENABLED=true

# Database. Prefer explicit migrations in production; AUTO_CREATE_SCHEMA is
# forced to false by configuration validation when ENVIRONMENT=production.
DATABASE_URL=
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=apisentry_db
AUTO_CREATE_SCHEMA=true

# Public self-registration is disabled by default, must be explicitly set in
# production (where only false is accepted), and is never an admin bootstrap.
APISENTRY_ENABLE_PUBLIC_REGISTRATION=false

# Demo auth is strictly local-only and disabled in production.
APISENTRY_ENABLE_DEMO_AUTH=false
DEMO_USERNAME=demo_user
DEMO_PASSWORD=

# Gate E / WP9 demo control-plane routers are isolated, default-disabled
# non-production demonstrations. Production cannot enable these routers.
APISENTRY_ENABLE_DEMO_CONTROL_PLANE=false

# Isolated local demo persistence. Empty resolves to a temp subdirectory.
MITIGATION_DEMO_DB_DIR=
